generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String          @id @default(cuid())
  name                 String
  email                String          @unique
  phoneNumber          String?         @unique @map("phonenumber")
  password             String
  refreshToken         String?
  emailVerified        Boolean         @default(false)
  phoneVerified        Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  activationCode       String?
  verifiedAt           DateTime?
  resetCode            String?
  // Verified two-step email change (see AuthenticationService.requestEmailChange).
  // The new address is NOT written to `email` until the code sent to it is
  // confirmed; `pendingEmailCancelToken` backs the "I didn't request this" link
  // in the notice sent to the current address.
  pendingEmail            String?
  pendingEmailCode        String?
  pendingEmailExpiresAt   DateTime?
  pendingEmailCancelToken String?   @unique
  isDeleted            Boolean         @default(false)
  deletedAt            DateTime?
  deletionScheduledFor DateTime?
  role                 String          @default("USER")
  googleId             String?         @unique
  googleEmail          String?
  // Apple's stable subject id (sub claim). Like googleId, this is the durable
  // account key for Sign in with Apple — it survives an email change, whereas
  // Apple private-relay emails can rotate.
  appleId              String?         @unique
  accountBlocked       Boolean         @default(false)
  blockedAt            DateTime?
  blockedReason        String?
  termsAccepted        Boolean         @default(false)
  termsAcceptedAt      DateTime?
  Team                 Team[]
  User                 TeamMember[]
  Subscription         Subscription?
  BillingInfo          BillingInfo?
  Feedback             Feedback[]
  Ticket               Ticket[]
  TicketMessage        TicketMessage[]
  Notification         Notification[]
  AssignedChats        CustomerChats[] @relation("AssignedAgent")
  PushTokens           PushToken[]
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Team {
  id                    String          @id @default(cuid())
  name                  String?
  ownerId               String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  businessName          String?
  companySize           CompanySize?
  industry              String?
  website               String?
  onboardingCompletedAt DateTime?
  // Live-chat handoff routing. defaultLiveChatAgentId is the fallback assignee
  // (used when no member has canLiveChat enabled) and the pre-selected option in
  // the manual handover modal. lastLiveChatAgentId is the round-robin cursor:
  // the userId that received the most recent auto-handoff for this team.
  // Both hold a User.id validated in code (like ownerId) — no FK on purpose.
  defaultLiveChatAgentId String?
  lastLiveChatAgentId    String?
  Content               Content[]
  CustomerBots          CustomerBots[]
  CustomerChats         CustomerChats[]
  IngestBatch           IngestBatch[]
  Integrations          Integrations[]
  Quota                 Quota[]
  Storage               Storage[]
  owner                 User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members               TeamMember[]
  Ticket                Ticket[]
}

model TeamMember {
  id              String   @id @default(cuid())
  teamId          String
  userId          String?
  email           String?
  role            String   @default("TEAM_MEMBER")
  status          String   @default("pending")
  // Whether this member takes part in live-chat handoff round-robin. Managers
  // who never handle live chat stay false; toggled from Team Settings.
  canLiveChat     Boolean  @default(false)
  invitationToken String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, email])
}

model Quota {
  id                       String     @id @default(cuid())
  teamId                   String
  quotaType                QuotaType?
  limit                    Int        @default(0)
  used                     Int        @default(0)
  voiceMessageMinutesUsed  Int?       @default(0)
  team                     Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, quotaType])
}

model Storage {
  id            String    @id @default(cuid())
  teamId        String
  botId         String
  fileName      String
  fileUrl       String
  type          String
  size          String
  status        String
  taskId        String
  ingestionInfo Json?
  fileHash      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean   @default(false)
  source        String?   @default("knowledge_base")
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Content {
  id            String    @id @default(cuid())
  teamId        String
  botId         String
  content       Json?
  type          String
  status        String
  taskId        String
  ingestionInfo Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean   @default(false)
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Phase B-3 (2026-07-21): the batch-summary endpoint fetches every
  // Content row for a given task_id to compute per-URL status. Without
  // this index, that's a full table scan on the Content table.
  @@index([taskId])
}

model CustomerBots {
  id                         String         @id @default(cuid())
  teamId                     String
  botName                    String
  botAvatar                  String
  systemPrompt               String         @default("")
  settings                   Json?
  purpose                    String?
  active                     Boolean        @default(false)
  modelTier                  String         @default("haiku")
  leadDestinations           Json           @default("[]")
  leadVerificationRequired   Boolean        @default(false)
  smsVerificationRequired    Boolean        @default(false)
  // Per-bot toggle for the KVKK Aydınlatma Metni + Kullanım Şartları
  // consent card shown to a visitor BEFORE they hand over a phone /
  // email in the widget lead + contact-form flows. Default true keeps
  // every existing bot on today's mandatory-consent behaviour. Owners
  // who collect KVKK consent themselves out-of-band (e.g. verbally on
  // the first call back) flip this off to drop the in-widget step —
  // SMS / email OTP verification is governed by its own flags
  // (sms/leadVerificationRequired) and is unaffected by this toggle.
  kvkkConsentRequired        Boolean        @default(true)
  // Per-bot toggle for the widget SSE streaming path (voice agent
  // plan Faz 2b, 2026-08-04). When true, the frontend widget sends
  // `Accept: text/event-stream` on `/widget/chat` and the backend
  // proxies the gateway SSE stream token-by-token instead of
  // buffering into a batch JSON body — perceived TTFB drops from
  // 3-5s to under a second. Default false for rollout gate: dev
  // enables it per pilot bot, prod flips per tenant after soak.
  // The batch path stays wired for `Accept: application/json` and
  // for every non-widget consumer (Meta/WhatsApp adapters) — those
  // never read this flag and always get the batch response.
  streamingEnabled           Boolean        @default(false)
  // Minutes-before-appointment offsets at which the reminder cron
  // should fire an SMS to the visitor. Introduced Faz E of the
  // SMS-booking migration (plan file: this-is-a-example-ticklish-dove.md).
  // Empty array disables reminders for this bot. Default [1440, 60]
  // matches the two checkboxes the FE bot-settings surface exposes
  // (24 hours before / 1 hour before). Owner picks 0, 1, or 2.
  appointmentReminderOffsets Int[]          @default([1440, 60])
  // Per-bot appointment availability window (inline calendar picker,
  // Faz 1). Nullable so application code keeps a `?? DEFAULT_WORKING_HOURS`
  // fallback (see appointment.constants.ts), but in practice every row is
  // backfilled to that same default by this field's migration, and
  // BotService.createBot writes it explicitly on create — NULL should not
  // occur in steady state, this is a belt-and-suspenders fallback only.
  appointmentWorkingHours    Json?
  // DEPRECATED (backlog #24 reverted 2026-08-29): kept as an inert column
  // to avoid a destructive migration on prod. Agent now derives appointment
  // duration from the retrieved KB chunk covering the visitor's stated
  // service and passes it directly to `request_booking_slot_picker` —
  // owner-curated catalog turned out to be redundant with KB stuffing +
  // retrieval. Drop in a future cleanup migration once the column has
  // stayed unread for a soak period.
  appointmentTypes           Json           @default("[]")
  // Wizard v2 structured intent inputs (2026-08-24, docs/WIZARD_V2.md).
  // All nullable / defaulted so v1 bots keep working unchanged;
  // wizardVersion distinguishes v1 (unstructured owner prompt) from
  // v2 (structured intents → meta-prompt v2 renders minimal templated
  // system prompt without freeform business-logic injection).
  capabilities               Json?
  persona                    Json?
  negatives                  String[]       @default([])
  primaryLanguage            String?
  wizardVersion              Int            @default(1)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  isDeleted                  Boolean        @default(false)
  deletedAt                  DateTime?
  team                       Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  BotLeads                   BotLeads[]
  ChatFeedback               ChatFeedback[]
  integrations               Integrations[]
  appointments               Appointment[]
}

model CustomerChats {
  id                  String                @id @default(cuid())
  teamId              String
  botId               String
  chatId              String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  isDeleted           Boolean               @default(false)
  deletedAt           DateTime?
  totalTokens         Int?
  chatStatus          ChatStatus            @default(BOT_ACTIVE)
  agentUserId         String?
  channel             ChatChannel           @default(WIDGET)
  externalContactId   String? // WhatsApp: wa_id (phone number), Messenger: PSID
  externalContactName String? // Best-effort display name fetched from the channel's profile API (currently: Instagram only)
  feedbackRating      Int? // 1-5 star rating submitted by the visitor after chat closes
  detectedLanguage    String? // ISO-639-1-ish code (tr/en/ru/ar/...) detected from the first user message; locked for the life of the chat so the gateway's per-turn language enforcement doesn't drift on later structured input (phone numbers, OTP codes)
  agent               User?                 @relation("AssignedAgent", fields: [agentUserId], references: [id])
  CustomerChatDetails CustomerChatDetails[]
  team                Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  GeoLocation         GeoLocation[]
}

model CustomerChatDetails {
  id           String        @id @default(cuid())
  chatId       String
  message      String
  sender       String
  tokenDetails Json?
  createdAt    DateTime      @default(now())
  attachments  Json?
  chat         CustomerChats @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model GeoLocation {
  id                String        @id @default(cuid())
  chatId            String
  ip                String
  country           String
  countryCode       String
  region            String
  city              String
  timezone          String
  organization      String
  organization_name String
  latitude          Float
  longitude         Float
  accuracy          Int
  createdAt         DateTime      @default(now())
  chat              CustomerChats @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model fastapi_ingestiontask {
  task_id          String   @id @db.VarChar
  customer_cuid    String   @db.VarChar
  bot_cuid         String   @db.VarChar
  status           String   @db.VarChar
  error_message    String?  @db.VarChar
  current_step     String?  @db.VarChar
  total_files      Int?     @default(0)
  processed_files  Int?     @default(0)
  total_chunks     Int?     @default(0)
  processed_chunks Int?     @default(0)
  progress_pct     Int?     @default(0)
  ingestion_type   String?  @db.VarChar
  tokens_consumed  Int?     @default(0)
  created_at       DateTime @db.Timestamp(6)
  updated_at       DateTime @db.Timestamp(6)

  @@index([bot_cuid], map: "ix_fastapi_ingestiontask_bot_cuid")
  @@index([customer_cuid], map: "ix_fastapi_ingestiontask_customer_cuid")
}

// Phase B-2 (2026-07-21): per-web-ingest-request batch record.
//
// Immutable request-side snapshot of what the user asked to ingest,
// keyed on the ML worker's task_id. `pageList` is the exact URL set
// sent to `/ingest-webpages` — the source of truth for retry-failed-
// only queries (join to Content by taskId to see per-URL outcome).
//
// Per-URL outcome + counts are NOT duplicated here; they live in
// `Content.ingestionInfo` (Phase B-1) and can be aggregated by
// `SELECT ... FROM Content WHERE taskId = X GROUP BY status` when
// the batch-summary endpoint (B-3) needs them.
model IngestBatch {
  id          String   @id @default(cuid())
  teamId      String
  botId       String
  // Matches `fastapi_ingestiontask.task_id`. Not a Prisma relation
  // because that table lives outside the app schema (owned by the
  // ML worker) — we join on task_id at read time when needed.
  taskId      String   @unique
  // The requested URL set. Kept verbatim so retry-failed-only can
  // reconstruct the original intent even if a Content row later
  // gets deleted for one of the URLs.
  pageList    Json
  // How the ingest was kicked off:
  //   initial   — first-time add via `POST /content/ingestWebPages`
  //   reingest  — re-ingest via `POST /content/reIngest`
  // Free-form string so future sources (scheduled, retry-failed)
  // don't need a migration.
  triggeredBy String   @default("initial")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([teamId, createdAt])
}

model Subscription {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  tier                      SubscriptionTier   @default(FREE)
  status                    SubscriptionStatus @default(INACTIVE)
  stripeCustomerId          String?            @unique
  stripeSubscriptionId      String?            @unique
  stripePriceId             String?
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  cancelAtPeriodEnd         Boolean            @default(false)
  monthlyTokenAllocation    Int                @default(0)
  tokensUsedThisMonth       Int                @default(0)
  additionalTokensPurchased Int                @default(0)
  spendingLimit             Float?
  activePricePlanId         String?
  tokenPricePlanId          String?
  scheduledPricePlanId      String?
  scheduledTokenPlanId      String?
  billingInterval           String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  activePricePlan           PricePlan?         @relation("ActivePricePlan", fields: [activePricePlanId], references: [id])
  scheduledPricePlan        PricePlan?         @relation("ScheduledPricePlan", fields: [scheduledPricePlanId], references: [id])
  scheduledTokenPlan        PricePlan?         @relation("ScheduledTokenPlan", fields: [scheduledTokenPlanId], references: [id])
  tokenPricePlan            PricePlan?         @relation("TokenPricePlan", fields: [tokenPricePlanId], references: [id])
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenUsageLogs            TokenUsageLog[]
}

model StripeProduct {
  id              String            @id @default(cuid())
  productType     StripeProductType @unique
  stripeProductId String            @unique
  lookupKey       String            @unique
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  pricePlans      PricePlan[]
}

model PricePlan {
  id                     String          @id @default(cuid())
  stripeProductId        String
  planType               PricePlanType
  stripePriceId          String?         @unique
  lookupKey              String?         @unique
  amountUsd              Float
  status                 PricePlanStatus @default(DRAFT)
  createdByAdminId       String?
  activatedAt            DateTime?
  archivedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  stripeProduct          StripeProduct   @relation(fields: [stripeProductId], references: [id])
  activeSubscriptions    Subscription[]  @relation("ActivePricePlan")
  scheduledSubscriptions Subscription[]  @relation("ScheduledPricePlan")
  scheduledTokenSubs     Subscription[]  @relation("ScheduledTokenPlan")
  tokenSubscriptions     Subscription[]  @relation("TokenPricePlan")

  @@index([status])
  @@index([planType])
}

model BillingInfo {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  firstName               String
  lastName                String
  email                   String
  address                 String
  country                 String
  stateRegion             String
  city                    String
  zipPostalCode           String
  isCompany               Boolean  @default(false)
  vatIdentificationNumber String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TokenUsageLog {
  id             String       @id @default(cuid())
  subscriptionId String
  teamId         String?
  botId          String?
  chatId         String?
  taskId         String?
  operationType  String       @default("chat")
  tokensUsed     Int
  cost           Float
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([taskId, operationType], name: "TokenUsageLog_taskId_operationType_key")
  @@index([operationType])
  @@index([teamId])
  @@index([createdAt])
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Integrations {
  id        String        @id @default(cuid())
  teamId    String
  botId     String?
  type      String
  config    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  bot       CustomerBots? @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([teamId, botId])
}

// One-time authorization code exchanged by the Chatbu Shopify app for a
// scoped 'shopify' access token. Mirrors the LeadSmsVerification shape
// (hashed code, expiry, single-use via usedAt).
model ShopifyAuthCode {
  id          String    @id @default(cuid())
  codeHash    String
  teamId      String
  userId      String
  redirectUri String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  @@index([codeHash])
  @@index([expiresAt])
}

model Feedback {
  id        String           @id @default(cuid())
  userId    String
  userName  String
  userEmail String
  category  FeedbackCategory
  message   String
  status    FeedbackStatus   @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ticket {
  id            String          @id @default(cuid())
  ticketNumber  String          @unique @default(cuid())
  userId        String
  teamId        String
  title         String
  description   String
  category      TicketCategory
  status        TicketStatus    @default(OPEN)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  resolvedAt    DateTime?
  notifications Notification[]
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]
}

model TicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  userId       String
  message      String
  isAdminReply Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  ticketId  String?
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id         String      @id @default(cuid())
  category   LogCategory
  action     LogAction
  status     LogStatus
  userId     String?
  userName   String?
  userEmail  String?
  teamId     String?
  entityId   String?
  entityName String?
  message    String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([category])
  @@index([userId])
  @@index([teamId])
  @@index([createdAt])
  @@index([status])
}

model BotLeads {
  id                String       @id @default(cuid())
  botId             String
  chatId            String?
  leadData          Json
  channelsAttempted Json         @default("[]")
  channelsSucceeded Json         @default("[]")
  deliveryErrors    Json?
  status            LeadStatus   @default(NEW)
  verified          Boolean      @default(false)
  smsVerified       Boolean      @default(false)
  privacyConsentId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bot               CustomerBots @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@index([botId, status])
}

model LeadVerification {
  id        String    @id @default(cuid())
  botId     String
  email     String
  codeHash  String
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([botId, email])
  @@index([expiresAt])
}

model LeadSmsVerification {
  id        String    @id @default(cuid())
  botId     String
  phone     String
  // ISO alpha-2 country of the destination phone (e.g. "TR", "US", "DE"),
  // parsed by `libphonenumber-js` in `SmsService.parsePhoneToE164`.
  // Nullable so rows written before Slice 2 (2026-08-13) keep working
  // without a backfill; new writes always populate. Used for cost
  // slicing (`chatbu_sms_send_total{country}` metric) + future per-
  // country daily-cap circuit breaker (Slice 6). Also used by
  // `LeadService.requestSmsVerification` to pick the OTP message
  // language (TR bots → Turkish body, everything else → English).
  country   String?
  codeHash  String
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([botId, phone])
  @@index([expiresAt])
}

// KVKK / GDPR-style consent audit log for phone-based lead capture.
// One row is created the moment a visitor accepts the Aydınlatma Metni +
// Kullanım Şartları (before their phone number is even known), then updated
// in place as the flow progresses so consent -> OTP -> lead is one row.
model LeadPrivacyConsent {
  id                     String    @id @default(cuid())
  botId                  String
  teamId                 String
  // Nullable so the widget can record consent BEFORE the first chat
  // POST has allocated a session_id (chicken-and-egg fix, 2026-08-01).
  // Backend binds this to a real chatId on the next chat POST via
  // `provisionalConsentId`, so gateway `has_fresh_kvkk_consent`
  // (which keys on botId+chatId) sees the consent right after.
  chatId                 String?
  phone                  String?
  source                 String    @default("chatbot")
  privacyVersion         String
  // Points at the LegalDocumentVersion actually shown to the visitor.
  // Nullable because rows created before this system existed have no version.
  legalDocumentVersionId String?
  locale                 String    @default("tr")
  // Slice 3 (2026-08-20): jurisdiction shorthand shown to the visitor.
  // 'gdpr' | 'kvkk' | 'ccpa' | 'pdpl' | 'generic'. Nullable; pre-Slice-3
  // rows are implicitly 'kvkk' since locale='tr' was the only shape.
  jurisdiction           String?
  // ISO alpha-2 country, populated by bindProvisionalConsent from
  // LeadSmsVerification.country once the OTP phone has been parsed.
  // Consent is written BEFORE the phone is known, so this stays NULL
  // between consent-accept and OTP-verify.
  country                String?
  privacyAcceptedAt      DateTime
  ipAddress              String?
  userAgent              String?
  otpVerified            Boolean   @default(false)
  otpVerifiedAt          DateTime?
  leadId                 String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([botId, chatId])
  @@index([leadId])
}

// ─── Per-chat flow orchestration state ───
// Foundation for the P2 state-machine refactor (plan file
// `.claude/plans/this-is-a-example-ticklish-dove.md`, Phase 1).
//
// The gateway (fovi-longa-chat-be) today has NO first-class per-chat
// state — the 197-line conditional prompt appendix + 30+ sentinel
// scans in chat_endpoint.py forces the model to infer "which step of
// which flow am I in?" from message history each turn. This model is:
//   (a) fragile — model swap or a missed sentinel produces "SMS
//       gönderdim" fabrications the 848-line LeadCaptureHonestyMiddleware
//       has to police after the fact
//   (b) invisible to backend cron / analytics / admin dashboards
//   (c) expensive — every turn eats ~500 tokens of orchestration prose
//
// This table is the authoritative store; the gateway probes
// `GET /api/chat-flow/:botId/:chatId` at turn start (same
// InternalApiKeyGuard shape as `hasFreshKvkkConsent`) and injects a
// ~5-10 line "CURRENT STEP" mini-block into the system prompt
// instead of the whole appendix.
//
// One row per (botId, chatId, flowKind) — independent lifecycles for
// LEAD vs BOOKING vs HANDOFF vs FEEDBACK on the same chat.
// `state` is a string (not an enum) on purpose: per-flow states will
// grow over the 5-phase rollout and schema churn per addition would
// be noise. Callers (ChatFlowService.transition) enforce the
// per-flow enum semantically.
//
// `payload` carries per-flow metadata (phone that was consented, OTP
// dispatch time, calendar slot picked, etc.). Kept opt-in so most
// transitions don't have to write anything beyond the state string.
model PerChatFlowState {
  id            String   @id @default(cuid())
  botId         String
  chatId        String
  flowKind      FlowKind
  state         String
  // Digits-only phone this flow SMS-verified for this chat, written by
  // BookingService/LeadService at their respective OTP_VERIFIED
  // transitions. Lets EITHER flow's request-SMS step check across BOTH
  // flowKinds for this (botId, chatId) before sending a new OTP — a
  // phone already verified via one flow doesn't need re-verifying via
  // the other in the same conversation. Nullable: most rows never reach
  // a verified phone state.
  verifiedPhone String?
  enteredAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payload       Json?

  @@unique([botId, chatId, flowKind])
  @@index([botId, state, updatedAt])
  @@index([chatId])
}

enum FlowKind {
  LEAD
  BOOKING
  HANDOFF
  FEEDBACK
}

// ─── Legal document management (KVKK, sales agreement, privacy policy, ...) ───
// Admin-authored, versioned legal text. A document (by slug) has many
// versions; only one version per document is PUBLISHED at a time. Each
// version holds one content row per locale, with Turkish as the always-
// present source and other locales translated + approved independently so
// translation work is never repeated for an unchanged version.

enum LegalDocumentVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TranslationStatus {
  SOURCE
  NEEDS_TRANSLATION
  TRANSLATED
  APPROVED
}

// Distinguishes this generic, append-only acceptance log from
// LeadPrivacyConsent, which is a mutable OTP-gating session object and
// stays separate from this table (see legal-document.service.ts).
enum LegalAcceptanceContext {
  PURCHASE
  SIGNUP
  OTHER
}

model LegalDocument {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions LegalDocumentVersion[]
}

model LegalDocumentVersion {
  id               String                     @id @default(cuid())
  documentId       String
  versionNumber    Int
  status           LegalDocumentVersionStatus @default(DRAFT)
  createdByAdminId String?
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  document    LegalDocument             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  contents    LegalDocumentContent[]
  acceptances LegalDocumentAcceptance[]

  @@unique([documentId, versionNumber])
  @@index([documentId, status])
}

model LegalDocumentContent {
  id                String            @id @default(cuid())
  versionId         String
  locale            String
  title             String
  bodyMarkdown      String
  translationStatus TranslationStatus @default(NEEDS_TRANSLATION)
  translatedAt      DateTime?
  approvedAt        DateTime?
  approvedByAdminId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  version LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, locale])
}

// Immutable audit record for consent captured outside the lead/OTP flow
// (purchase checkout, signup, etc). Never updated after creation.
model LegalDocumentAcceptance {
  id          String                 @id @default(cuid())
  documentId  String
  versionId   String
  locale      String
  context     LegalAcceptanceContext
  subjectType String
  subjectId   String?
  teamId      String?
  ipAddress   String?
  userAgent   String?
  acceptedAt  DateTime               @default(now())
  createdAt   DateTime               @default(now())

  version LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([documentId, versionId])
  @@index([subjectType, subjectId])
}

model ChatFeedback {
  id                String         @id @default(cuid())
  botId             String
  chatId            String?
  answer            FeedbackAnswer
  comment           String?
  channelsAttempted Json           @default("[]")
  channelsSucceeded Json           @default("[]")
  deliveryErrors    Json?
  createdAt         DateTime       @default(now())
  bot               CustomerBots   @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
}

model BookingVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  botCuid   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, botCuid])
  @@index([expiresAt])
}

// SMS-based counterpart of BookingVerification. Introduced Faz B of the
// SMS-booking migration (plan file: this-is-a-example-ticklish-dove.md).
// Same shape modulo email→phone. Kept as a SEPARATE table (not a new
// column on BookingVerification) so the email flow can keep serving
// in-flight MCP callers until Faz C flips them over. Both tables will
// be reconciled in a later cleanup cycle once the email path is unused.
model BookingSmsVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  botCuid   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, botCuid])
  @@index([expiresAt])
}

// Persisted record of a completed booking. Introduced in Faz D of the
// SMS-booking migration (plan file: this-is-a-example-ticklish-dove.md).
// Two callers today:
//   - AppointmentService.createFromMcp() inserts one row per successful
//     MCP `create_appointment` (bridged via the /appointment-created
//     hop from the MCP server).
//   - AppointmentReminderService (Faz E) scans upcoming rows every
//     minute and sends SMS reminders based on the bot's configured
//     offsets, updating `reminderStates` per-offset so a reminder can
//     never fire twice for the same slot.
//
// Google Calendar remains the visitor-facing source of truth (invite
// email + cancel/reschedule buttons), but the calendar has no API for
// "list events starting in the next 24 hours across all bots"; we
// persist here so a per-minute cron can efficiently find what's due
// without walking every bot's calendar over HTTP.
model Appointment {
  id              String       @id @default(cuid())
  botId           String
  calendarEventId String
  attendeeName    String
  attendeePhone   String
  attendeeEmail   String
  startAt         DateTime
  endAt           DateTime
  summary         String
  description     String       @default("")
  timezone        String       @default("UTC")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  // Per-offset reminder dispatch state. Keys are the offset in minutes
  // as strings ("1440", "60", ...); values are "pending" | "sent" |
  // "failed". `pending` is implicit (absence of the key is the same as
  // "not tried yet") so an empty {} on insert is fine — the cron
  // updates the key on each dispatch attempt so retries don't double-
  // fire.
  reminderStates  Json         @default("{}")
  bot             CustomerBots @relation(fields: [botId], references: [id], onDelete: Cascade)

  // A single Google Calendar event should map to at most one Appointment
  // row per bot. The MCP hop is idempotent (fail-open, but a retry could
  // still fire twice); a unique key here catches any duplicate hop
  // attempt at the DB layer rather than doubling reminders downstream.
  @@unique([botId, calendarEventId])
  @@index([botId])
  @@index([startAt])
}

model WidgetVisitor {
  id                String   @id @default(cuid())
  visitorId         String   @unique
  chatbotId         String
  domain            String
  fingerprintHash   String
  ipHash            String
  userAgentHash     String
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @updatedAt
  messageCountToday Int      @default(0)
  tokenUsageToday   Int      @default(0)
  dailyResetAt      DateTime @default(now())
  riskScore         Float    @default(0.0)
  isBlocked         Boolean  @default(false)
  blockedReason     String?

  @@index([chatbotId])
  @@index([fingerprintHash, chatbotId])
  @@index([isBlocked])
  @@index([lastSeenAt])
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
  @@index([thread_id])
}

model checkpoint_migrations {
  v Int @id
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes
  task_path     String  @default("")

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
  @@index([thread_id])
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
  @@index([thread_id])
}

